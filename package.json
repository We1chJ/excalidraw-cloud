{
  "name": "excalidraw-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension that embeds the Excalidraw editor and syncs drawings to your own Google Drive.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "copy-assets": "node scripts/copy-excalidraw-assets.mjs",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs",
    "check:remote": "node scripts/check-no-remote-code.mjs",
    "harness": "node scripts/make-harness.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.28",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.6"
  }
}
